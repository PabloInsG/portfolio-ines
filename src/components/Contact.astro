---
import '../styles/global.css';
import SocialPills from './SocialPills.astro';
import Mail from '../icons/Mail.astro';
import Instagram from '../icons/Instagram.astro';
import Footer from './Footer.astro';
---

<div class="w-full h-screen bg-neutral-950 z-40">
    <div class="flex items-center justify-center h-40">
        <h2 class="text-7xl mt-10">Contacto</h2>
    </div>
    <div class="flex flex-col p-4 md:h-9/12">
        <p class="text-3xl">Para contactar conmigo</p>
        <div class="flex flex-col md:flex-row gap-4">
            <SocialPills href="https://mail.google.com/mail/?view=cm&fs=1&tf=1&to=inesmolinacastro@gmail.com" class="mt-2 hover:scale-110">
                        <Mail class="size-4 md:size-6"></Mail>
                        inesmolinacastro@gmail.com
            </SocialPills>
            <SocialPills href="https://www.instagram.com/ines78yt/" class="mt-2 hover:scale-110">
                <Instagram class="size-4 md:size-6"></Instagram>
                @ines78yt
            </SocialPills>
        </div>
    </div>
    <Footer />
</div>