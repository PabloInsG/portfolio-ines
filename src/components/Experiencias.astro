---
interface Props {
    title?: string
    description?: string
    link?: string
    date?: string
}

const {title, description, link, date} = Astro.props;
---

<div class="absolute w-3 h-3 bg-gray-200 rounded-full mt-1.5 -start-1.5 border border-white dark:border-gray-900 dark:bg-white-700"></div>
        <time class="mb-1 text-sm font-normal leading-none text-white-400 dark:text-white-500">{date}</time>
        <h3 class="text-lg font-semibold text-blue-200 dark:text-blue-300">{title}</h3>
        <p class="mb-4 text-base font-normal text-gray-500 dark:text-white/80">{description}</p>
</div>