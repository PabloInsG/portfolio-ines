---
import '../styles/global.css';
import img9636_R from '../assets/gallery/IMG_9636_R.jpg';
import img9637_R from '../assets/gallery/IMG_9637_R.jpg';
import img9638_R from '../assets/gallery/IMG_9638_R.jpg';
import img9639_A from '../assets/gallery/IMG_9639_A.jpg';
import img9640_A from '../assets/gallery/IMG_9640_A.jpg';
import img9641_A from '../assets/gallery/IMG_9641_A.jpg';


const images = [
    img9636_R.src,
    img9641_A.src,
    img9637_R.src,
    img9640_A.src,
    img9638_R.src,
    img9639_A.src,
];
---

<div class="w-full bg-neutral-950 z-10">
    <div class="flex items-center justify-center h-40">
        <h2 class="text-7xl">Book</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-4 p-4">
        {images.map((img) => (
            <div class="flex items-center justify-center">
                <img src={img} alt={`Book Image ${img}`} class="max-w-full h-auto" />
            </div>
            ))
        }
    </div>
</div>